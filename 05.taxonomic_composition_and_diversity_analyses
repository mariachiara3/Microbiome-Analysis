def shannon(counts: np.ndarray) -> float:
    counts = counts[counts > 0]
    total = np.sum(counts)
    if total == 0:
        return 0.0
    p = counts / total
    return float(-np.sum(p * np.log(p)))


def simpson(counts: np.ndarray) -> float:
    counts = counts[counts > 0]
    total = np.sum(counts)
    if total == 0:
        return 0.0
    p = counts / total
    return float(np.sum(p ** 2))


def draw_ellipse(x: np.ndarray, y: np.ndarray, ax, color: str, confidence_level: float = 0.95, linewidth: int = 1) -> None:
    if len(x) < 2:
        return
    try:
        cov = np.cov(x, y)
        eigvals, eigvecs = np.linalg.eig(cov)
        eigvals[eigvals <= 1e-10] = 1e-10
        axes = np.sqrt(eigvals)
        scale = chi2.ppf(confidence_level, 2)

        angle = np.degrees(np.arccos(eigvecs[0, 0]))
        ell = Ellipse(
            xy=(np.mean(x), np.mean(y)),
            width=axes[0] * 2 * np.sqrt(scale),
            height=axes[1] * 2 * np.sqrt(scale),
            angle=angle,
            edgecolor=color,
            fill=False,
            linewidth=linewidth,
        )
        ax.add_artist(ell)
    except Exception:
        return


def pcoa_manual(dist_matrix: np.ndarray, index_names: List[str]) -> Tuple[pd.DataFrame, np.ndarray]:
    D = squareform(dist_matrix)
    n = D.shape[0]
    D2 = D ** 2
    J = np.eye(n) - np.ones((n, n)) / n
    B = -0.5 * J.dot(D2).dot(J)

    eigvals, eigvecs = eigh(B)
    idx = eigvals.argsort()[::-1]
    eigvals = eigvals[idx]
    eigvecs = eigvecs[:, idx]

    positive = eigvals[eigvals > 1e-6]
    num_dims = min(2, len(positive))
    if num_dims == 0:
        return pd.DataFrame(index=index_names), eigvals

    coords = eigvecs[:, :num_dims] @ np.sqrt(np.diag(positive[:num_dims]))
    coords_df = pd.DataFrame(coords, index=index_names)
    coords_df.columns = ["PC1", "PC2"] if num_dims == 2 else ["PC1"]
    return coords_df, eigvals


def permanova_test(dist_matrix: np.ndarray, groups: np.ndarray, permutations: int = 999) -> Tuple[float, float, int]:
    if len(np.unique(groups)) <= 1:
        return np.nan, np.nan, permutations

    D2 = squareform(dist_matrix) ** 2
    n = D2.shape[0]
    SST = np.sum(D2) / (2 * n)

    groups_unique = np.unique(groups)
    SSW = 0.0
    for g in groups_unique:
        idx = np.where(groups == g)[0]
        n_g = len(idx)
        if n_g < 2:
            continue
        Dg = D2[idx[:, None], idx]
        SSW += np.sum(Dg) / (2 * n_g)

    SSA = SST - SSW
    df_A = len(groups_unique) - 1
    df_W = n - len(groups_unique)
    if df_W <= 0:
        return np.nan, np.nan, permutations

    MSA = SSA / df_A
    MSW = SSW / df_W
    F_obs = MSA / MSW if MSW > 1e-9 else np.nan
    if np.isnan(F_obs):
        return np.nan, np.nan, permutations

    F_perm = []
    for _ in range(permutations):
        perm = np.random.permutation(groups)
        SSW_p = 0.0
        for g in groups_unique:
            idx = np.where(perm == g)[0]
            n_g = len(idx)
            if n_g < 2:
                continue
            Dg = D2[idx[:, None], idx]
            SSW_p += np.sum(Dg) / (2 * n_g)
        SSA_p = SST - SSW_p
        MSA_p = SSA_p / df_A
        MSW_p = SSW_p / df_W
        F_perm.append(MSA_p / MSW_p if MSW_p > 1e-9 else 0.0)

    F_perm = np.asarray(F_perm)
    p_value = (np.sum(F_perm >= F_obs) + 1) / (permutations + 1)
    return float(F_obs), float(p_value), permutations


# -----------------------------
# Post-hoc helpers (uncorrected)
# -----------------------------

def pairwise_wilcoxon_uncorrected(alpha_df: pd.DataFrame, metric: str) -> pd.DataFrame:
    groups = alpha_df["group"].unique()
    out = []
    for g1, g2 in combinations(groups, 2):
        d1 = alpha_df.loc[alpha_df["group"] == g1, metric].dropna().values
        d2 = alpha_df.loc[alpha_df["group"] == g2, metric].dropna().values

        if len(d1) < 2 or len(d2) < 2:
            stat, p = np.nan, np.nan
        else:
            try:
                stat, p = ranksums(d1, d2)
            except Exception:
                stat, p = np.nan, np.nan

        out.append(
            {
                "Comparison": f"{g1} vs {g2}",
                "W_Stat": stat,
                "P_Value": p,
                "Significant": (p < 0.05) if not np.isnan(p) else False,
            }
        )
    return pd.DataFrame(out)


def pairwise_permanova_uncorrected(dist_matrix: np.ndarray, groups: np.ndarray) -> pd.DataFrame:
    groups_unique = np.unique(groups)
    out = []
    D = squareform(dist_matrix)

    for g1, g2 in combinations(groups_unique, 2):
        idx1 = np.where(groups == g1)[0]
        idx2 = np.where(groups == g2)[0]

        if len(idx1) < 2 or len(idx2) < 2:
            F_stat, p = np.nan, np.nan
        else:
            combined = np.concatenate([idx1, idx2])
            D_sub = D[combined[:, None], combined]
            dist_sub = squareform(D_sub)
            groups_sub = groups[combined]
            F_stat, p, _ = permanova_test(dist_sub, groups_sub, permutations=499)

        out.append(
            {
                "Comparison": f"{g1} vs {g2}",
                "F_Stat": F_stat,
                "P_Value": p,
                "Significant": (p < 0.05) if not np.isnan(p) else False,
            }
        )
    return pd.DataFrame(out)


def create_summary_report(all_posthoc_results: Dict[str, pd.DataFrame], group_label: str, output_dir: str) -> None:
    report_path = os.path.join(output_dir, f"stat_report_significant_summary_{group_label.lower()}.txt")

    all_p = []
    for df in all_posthoc_results.values():
        all_p.extend(df["P_Value"].dropna().astype(float).values)

    if len(all_p) == 0:
        with open(report_path, "w") as f:
            f.write("No statistically significant differences (P < 0.05) detected in post-hoc tests.\n")
        print(f"[OK] Significant summary report saved: {report_path}")
        return

    rejected, p_corr, _, _ = multipletests(all_p, alpha=0.05, method="fdr_bh")

    idx = 0
    for df in all_posthoc_results.values():
        for i in range(len(df)):
            pval = df.iloc[i]["P_Value"]
            if pd.isna(pval):
                continue
            df.at[df.index[i], "P_Value_Corrected"] = p_corr[idx]
            df.at[df.index[i], "Significant_FDR"] = p_corr[idx] < 0.05
            idx += 1

    with open(report_path, "w") as f:
        f.write("==========================================================\n")
        f.write("SIGNIFICANT RESULTS (FDR-corrected P < 0.05)\n")
        f.write(f"Group: {group_label}\n")
        f.write("==========================================================\n\n")

        found = False
        for test_name, df in all_posthoc_results.items():
            sig = df[df.get("Significant_FDR", False)].copy()
            if sig.empty:
                continue
            found = True
            f.write(f"--- Test: {test_name.replace('_', ' ').upper()} ---\n")
            for _, row in sig.iterrows():
                p = float(row["P_Value_Corrected"])
                stars = "***" if p < 0.001 else ("**" if p < 0.01 else ("*" if p < 0.05 else ""))
                f.write(f"{row['Comparison']}: p={p:.3g} {stars}\n")
            f.write("\n")

        if not found:
            f.write("No statistically significant differences (FDR-corrected P < 0.05).\n")

    print(f"[OK] Significant summary report saved: {report_path}")


