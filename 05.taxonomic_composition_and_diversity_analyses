def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Abundance + diversity plots/stats for Nanopore full-length 16S pipeline."
    )

    p.add_argument("--adult-folders", nargs="+", required=True, help="List of adult treatment directories.")
    p.add_argument("--nymph-folders", nargs="+", required=True, help="List of nymph treatment directories.")
    p.add_argument("--adult-diversity-csv", required=True, help="Adult diversity input CSV (rows=samples, cols=counts).")
    p.add_argument("--nymph-diversity-csv", required=True, help="Nymph diversity input CSV (rows=samples, cols=counts).")
    p.add_argument("--outdir", required=True, help="Base output directory.")
    p.add_argument("--top-n", type=int, default=10, help="Top N taxa for stacked barplots (default: 10).")

    return p.parse_args()


def main() -> None:
    args = parse_args()

    out_abund_adults = os.path.join(args.outdir, "abundance_plots_adults_subsampled")
    out_abund_nymphs = os.path.join(args.outdir, "abundance_plots_nymphs_subsampled")
    out_div_adults = os.path.join(args.outdir, "diversity_plots_adults_subsampled")
    out_div_nymphs = os.path.join(args.outdir, "diversity_plots_nymphs_subsampled")

    for d in [out_abund_adults, out_abund_nymphs, out_div_adults, out_div_nymphs]:
        os.makedirs(d, exist_ok=True)

    # Abundance
    df_adults, map_adults = process_abundance_analysis_initial(args.adult_folders, "Adults", FULL_FOLDER_NAME_MAPPING)
    df_nymphs, map_nymphs = process_abundance_analysis_initial(args.nymph_folders, "Nymphs", FULL_FOLDER_NAME_MAPPING)

    global_color_map_genus = create_global_color_map(
        df_list=[df_adults, df_nymphs],
        category="genere",
        top_n=args.top_n,
        palette=DEFAULT_PALETTE,
        fixed_map=FIXED_COLOR_MAP_GENUS,
        borrelia_color=None,
    )

    global_color_map_species = create_global_color_map(
        df_list=[df_adults, df_nymphs],
        category="specie",
        top_n=args.top_n,
        palette=DEFAULT_PALETTE,
        fixed_map={},
        borrelia_color=None,
    )

    process_plotting(
        df_adults,
        "Adults",
        out_abund_adults,
        global_color_map_genus,
        global_color_map_species,
        map_adults,
        ORDERED_TREATMENTS,
        top_n=args.top_n,
    )

    process_plotting(
        df_nymphs,
        "Nymphs",
        out_abund_nymphs,
        global_color_map_genus,
        global_color_map_species,
        map_nymphs,
        ORDERED_TREATMENTS,
        top_n=args.top_n,
    )

    # Diversity
    analyze_diversity(args.adult_diversity_csv, out_div_adults, "Adults")
    analyze_diversity(args.nymph_diversity_csv, out_div_nymphs, "Nymphs")

    print("\n[OK] Pipeline completed.")


if __name__ == "__main__":
    main()
