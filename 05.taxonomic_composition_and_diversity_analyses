    )

    try:
        table = pd.read_csv(input_file, index_col=0)
    except FileNotFoundError:
        print(f"[WARN] File not found: {input_file}. Skipping {group_label}.")
        return

    df_final = table.copy()
    if df_final.empty:
        print(f"[WARN] Empty table for {group_label}.")
        return

    df_final = df_final.loc[:, (df_final != 0).any(axis=0)]

    def extract_treatment(sample_name: str) -> str:
        parts = sample_name.lower().split("_")
        if "lyzo" in parts and "zap" in parts:
            return "lyzo_zap"
        if "lyzo" in parts and ("cand" in parts or "candeggina" in parts):
            return "lyzo_cand"
        if "etanolo" in parts:
            return "etanolo"
        if "controllo" in parts:
            return "controllo"
        if "zap" in parts:
            return "zap"
        if "candeggina" in parts or "cand" in parts:
            if "vecchia" in parts:
                return "Old_Bleach"
            return "candeggina"
        return "unknown"

    group_keys_raw = df_final.index.to_series().apply(extract_treatment)
    sample_to_group = group_keys_raw.apply(lambda x: SHORT_TREATMENT_MAPPING.get(x, x))
    groups = sample_to_group.values
    unique_groups = np.unique(groups)

    if len(unique_groups) < 2:
        print("[WARN] Fewer than 2 unique groups. Skipping statistics/plots.")
        return

    results = []
    all_posthoc_results: Dict[str, pd.DataFrame] = {}

    # Alpha diversity (Shannon, Simpson) + Kruskal-Wallis + per-metric boxplots
    print("\n--- Alpha diversity (Shannon, Simpson) ---")
    alpha_df = pd.DataFrame(index=df_final.index)
    alpha_df["shannon"] = df_final.apply(shannon, axis=1)
    alpha_df["simpson"] = df_final.apply(simpson, axis=1)
    alpha_df["group"] = sample_to_group

    for metric in ["shannon", "simpson"]:
        group_data = [alpha_df.loc[alpha_df["group"] == g, metric].dropna().values for g in unique_groups]
        valid_data = [d for d in group_data if len(d) >= 2]

        H_stat, p_value = np.nan, np.nan
        if len(valid_data) >= 2:
            try:
                H_stat, p_value = kruskal(*valid_data)
            except Exception as e:
                print(f"[WARN] Kruskal-Wallis failed for {metric}: {e}")

        is_sig = (not np.isnan(p_value)) and (p_value < 0.05)

        results.append(
            {
                "Metric": f"Alpha ({metric.title()})",
                "Test": "Kruskal-Wallis H",
                "Statistic": f"{H_stat:.3f}" if not np.isnan(H_stat) else "NA",
                "P-value": f"{p_value:.5f}" if not np.isnan(p_value) else "NA",
                "Significant": "YES" if is_sig else ("NO" if not np.isnan(p_value) else "NA"),
            }
        )

        if is_sig:
            ph = pairwise_wilcoxon_uncorrected(alpha_df, metric)
            all_posthoc_results[f"Alpha_{metric}_PostHoc"] = ph

        # Single alpha plot per metric (no combined plots)
        plt.figure(figsize=(10, 7))
        plot_order = [t for t in ORDERED_TREATMENTS if t in alpha_df["group"].unique()]
        sns.boxplot(
            x="group",
            y=metric,
            data=alpha_df,
            order=plot_order,
            palette={t: TREATMENT_PALETTE[t] for t in plot_order if t in TREATMENT_PALETTE},
        )
        sns.stripplot(
            x="group",
            y=metric,
            data=alpha_df,
            order=plot_order,
            color=".25",
            jitter=True,
            size=5,
        )
        p_text = f"P={p_value:.3f}" if not np.isnan(p_value) else "P=NA"
        plt.title(f"{metric.title()} diversity\nKruskal-Wallis {p_text}", fontsize=16)
        plt.xlabel("Group", fontsize=12)
        plt.ylabel(f"{metric.title()} index", fontsize=12)
        plt.xticks(rotation=45, ha="right")
        plt.tight_layout()
        plt.savefig(os.path.join(output_dir, f"boxplot_{metric}_{group_label.lower()}.png"), dpi=300)
        plt.close()

    # Beta diversity (Bray-Curtis, Jaccard) + PERMANOVA + PCoA (one plot per metric)
    print("\n--- Beta diversity (PCoA + PERMANOVA) ---")
    dist_bray = pdist(df_final, metric="braycurtis")
    dist_jacc = pdist(df_final, metric="jaccard")
    beta_metrics = {"Bray-Curtis": dist_bray, "Jaccard": dist_jacc}

    for metric_name, dist_matrix in beta_metrics.items():
        F_stat, p_value, n_perm = permanova_test(dist_matrix, groups, permutations=999)
        is_sig = (not np.isnan(p_value)) and (p_value < 0.05)

        results.append(
            {
                "Metric": f"Beta ({metric_name})",
                "Test": f"PERMANOVA ({n_perm} perm.)",
                "Statistic": f"{F_stat:.3f}" if not np.isnan(F_stat) else "NA",
                "P-value": f"{p_value:.5f}" if not np.isnan(p_value) else "NA",
                "Significant": "YES" if is_sig else ("NO" if not np.isnan(p_value) else "NA"),
            }
        )

        if is_sig:
            ph = pairwise_permanova_uncorrected(dist_matrix, groups)
            all_posthoc_results[f"Beta_{metric_name}_PostHoc"] = ph

        df_pcoa, eigvals = pcoa_manual(dist_matrix, df_final.index.tolist())
        if "PC2" not in df_pcoa.columns:
            continue

        df_pcoa["group"] = sample_to_group.values
        plot_order = [t for t in ORDERED_TREATMENTS if t in df_pcoa["group"].unique()]
        palette_ordered = {t: TREATMENT_PALETTE[t] for t in plot_order if t in TREATMENT_PALETTE}

        fig, ax = plt.subplots(figsize=(10, 8))
        sns.scatterplot(
            x="PC1",
            y="PC2",
            hue="group",
            style="group",
            hue_order=plot_order,
            style_order=plot_order,
            data=df_pcoa,
            s=100,
            palette=palette_ordered,
            ax=ax,
        )

        total_eig = np.sum(eigvals[eigvals > 1e-6])
        pc1_var = eigvals[0] / total_eig if total_eig > 0 else 0
        pc2_var = eigvals[1] / total_eig if total_eig > 0 else 0

        ax.set_xlabel(f"PCo1 ({pc1_var:.2%})")
        ax.set_ylabel(f"PCo2 ({pc2_var:.2%})")
        title_stat = f"PERMANOVA F={F_stat:.3f}, P={p_value:.3f}" if not np.isnan(F_stat) else "PERMANOVA: NA"
        ax.set_title(f"PCoA ({metric_name})\n{title_stat}")
        ax.legend(title="Groups", bbox_to_anchor=(1.05, 1), loc="upper left")

        plt.tight_layout()
        out = os.path.join(output_dir, f"pcoa_{metric_name.replace('-', '_')}_{group_label.lower()}.png")
        plt.savefig(out, dpi=300)
        plt.close()

    # Save summaries
    results_df = pd.DataFrame(results)
    out_global = os.path.join(output_dir, f"stat_summary_global_{group_label.lower()}.csv")
    results_df.to_csv(out_global, index=False)
    print(f"[OK] Global stats saved: {out_global}")

    if all_posthoc_results:
        for test_name, df in all_posthoc_results.items():
            out_ph = os.path.join(output_dir, f"stat_summary_{test_name.lower()}_uncorrected.csv")
            df.to_csv(out_ph, index=False)
        create_summary_report(all_posthoc_results, group_label, output_dir)


