def normalize_label_cli(label: str) -> str:
    return label.strip().lower().replace(" ", "_").replace("/", "_")

def _tokenize(s: str):
    s = str(s).lower().replace("\\", "/")
    parts = re.split(r"[\/\W]+|_", s)
    return [p for p in parts if p]

def extract_treatment_from_sample(sample_name: str, ordered_treatments_norm):
    """
    Finds the FIRST match of a treatment token-sequence in the sample string,
    preferring longer patterns.
    """
    toks = _tokenize(sample_name)

    patterns = []
    for key in ordered_treatments_norm:
        pat = _tokenize(key)
        patterns.append((key, pat))

    patterns.sort(key=lambda x: (-len(x[1]), ordered_treatments_norm.index(x[0])))

    for key, pat in patterns:
        L = len(pat)
        if L == 0:
            continue
        for i in range(len(toks) - L + 1):
            if toks[i:i + L] == pat:
                return key
    return "unknown"

def shannon(counts: np.ndarray) -> float:
    x = counts[counts > 0]
    N = x.sum()
    if N <= 0:
        return 0.0
    p = x / N
    return float(-np.sum(p * np.log(p)))

def simpson_concentration(counts: np.ndarray) -> float:
    """
    Simpson concentration index (dominance): sum(p^2).
    (Note: smaller = more diverse; larger = more dominated.)
    """
    x = counts[counts > 0]
    N = x.sum()
    if N <= 0:
        return 0.0
    p = x / N
    return float(np.sum(p ** 2))


def pcoa_manual(dist_vector, index_names):
    D = squareform(dist_vector)
    n = D.shape[0]
    D2 = D ** 2
    J = np.eye(n) - np.ones((n, n)) / n
    B = -0.5 * J @ D2 @ J

    eigvals, eigvecs = eigh(B)
    idx = eigvals.argsort()[::-1]
    eigvals = eigvals[idx]
    eigvecs = eigvecs[:, idx]

    pos = eigvals[eigvals > 1e-9]
    k = min(2, len(pos))
    if k == 0:
        return pd.DataFrame(index=index_names), eigvals

    coords = eigvecs[:, :k] @ np.sqrt(np.diag(pos[:k]))
    cols = ["PC1", "PC2"] if k == 2 else ["PC1"]
    return pd.DataFrame(coords, index=index_names, columns=cols), eigvals

def permanova_test(dist_vector, groups, permutations=999, seed=123):
    groups = np.asarray(groups, dtype=object)
    uniq = np.unique(groups)
    if len(uniq) <= 1:
        return np.nan, np.nan, permutations

    D2 = squareform(dist_vector) ** 2
    n = D2.shape[0]
    SST = np.sum(D2) / (2 * n)

    def ssw(labels):
        SSW = 0.0
        for g in uniq:
            idx = np.where(labels == g)[0]
            ng = len(idx)
            if ng < 2:
                continue
            Dg = D2[idx[:, None], idx]
            SSW += np.sum(Dg) / (2 * ng)
        return SSW

    SSW_obs = ssw(groups)
    SSA_obs = SST - SSW_obs

    dfA = len(uniq) - 1
    dfW = n - len(uniq)
    if dfW <= 0:
        return np.nan, np.nan, permutations

    MSA = SSA_obs / dfA
    MSW = SSW_obs / dfW
    F_obs = MSA / MSW if MSW > 1e-12 else np.nan
    if np.isnan(F_obs):
        return np.nan, np.nan, permutations

    rng = np.random.default_rng(seed)
    F_perm = np.empty(permutations, dtype=float)
    for i in range(permutations):
        perm = rng.permutation(groups)
        SSW_p = ssw(perm)
        SSA_p = SST - SSW_p
        MSA_p = SSA_p / dfA
        MSW_p = SSW_p / dfW
        F_perm[i] = (MSA_p / MSW_p) if MSW_p > 1e-12 else 0.0

    p = (np.sum(F_perm >= F_obs) + 1) / (permutations + 1)
    return float(F_obs), float(p), permutations

def pairwise_vs_control_wilcoxon(alpha_df, metric, control_group, group_col="group",
                                mtc_method="holm", alpha=0.05):
    """
    Planned comparisons: each treatment vs control.
    Test: Wilcoxon rank-sum (scipy.stats.ranksums) for independent samples.
    Multiplicity correction applied ONLY across these vs-control p-values.
    """
    groups = alpha_df[group_col].astype(str).unique().tolist()
    if control_group not in groups:
        print(f" control_group='{control_group}' not found in groups: {groups}")
        return pd.DataFrame()

    ctrl = alpha_df.loc[alpha_df[group_col] == control_group, metric].dropna().values
    rows = []
    for g in groups:
        if g == control_group:
            continue

        x = alpha_df.loc[alpha_df[group_col] == g, metric].dropna().values
        if len(ctrl) < 2 or len(x) < 2:
            rows.append({
                "Comparison": f"{g} vs {control_group}",
                "W": np.nan,
                "P_raw": np.nan
            })
            continue

        try:
            res = mannwhitneyu(
                x,
                ctrl,
                alternative="two-sided",
                method="exact"
            )

            W = res.statistic
            p = res.pvalue  # two-sided by default
        except Exception:
            W, p = np.nan, np.nan

        rows.append({
            "Comparison": f"{g} vs {control_group}",
            "W": float(W) if np.isfinite(W) else np.nan,
            "P_raw": float(p) if np.isfinite(p) else np.nan
        })

    df = pd.DataFrame(rows)

    # correction only on valid p-values
    pvals = df["P_raw"].values.astype(float)
    mask = np.isfinite(pvals)
    adj_col = f"P_{mtc_method}"
    if mask.sum() > 0:
        rej, p_adj, _, _ = multipletests(pvals[mask], alpha=alpha, method=mtc_method)
        df.loc[mask, adj_col] = p_adj
        df.loc[mask, "Significant_adj"] = rej
    else:
        df[adj_col] = np.nan
        df["Significant_adj"] = False

    return df


def pairwise_permanova_vs_control(dist_vector, groups, control_group,
                                 permutations=499, seed=123,
                                 mtc_method="holm", alpha=0.05):
    """
    Planned comparisons: each treatment vs control (pairwise PERMANOVA).
    Multiplicity correction applied ONLY across these vs-control p-values.
    """
    groups = np.asarray(groups, dtype=object)
    uniq = np.unique(groups)
    if control_group not in uniq:
        print(f" control_group='{control_group}' not found in: {list(uniq)}")
        return pd.DataFrame()

    D = squareform(dist_vector)
    idx_ctrl = np.where(groups == control_group)[0]
    if len(idx_ctrl) < 2:
        print(" control group has <2 samples; cannot run vs-control PERMANOVA.")
        return pd.DataFrame()

    rows = []
    for g in uniq:
        if g == control_group:
            continue

        idx_g = np.where(groups == g)[0]
        if len(idx_g) < 2:
            rows.append({"Comparison": f"{g} vs {control_group}", "F": np.nan, "P_raw": np.nan})
            continue

        combined = np.concatenate([idx_ctrl, idx_g])
        D_sub = D[combined[:, None], combined]
        dist_sub = squareform(D_sub)
        g_sub = groups[combined]

        pair_seed = (hash((str(g), str(control_group), int(seed))) % (2**32 - 1))
        F, p, _ = permanova_test(dist_sub, g_sub, permutations=permutations, seed=pair_seed)
        rows.append({"Comparison": f"{g} vs {control_group}", "F": float(F), "P_raw": float(p)})

    df = pd.DataFrame(rows)

    pvals = df["P_raw"].values.astype(float)
    mask = np.isfinite(pvals)
    adj_col = f"P_{mtc_method}"
    if mask.sum() > 0:
        rej, p_adj, _, _ = multipletests(pvals[mask], alpha=alpha, method=mtc_method)
        df.loc[mask, adj_col] = p_adj
        df.loc[mask, "Significant_adj"] = rej
    else:
        df[adj_col] = np.nan
        df["Significant_adj"] = False

    return df


def write_significant_report_vs_control(posthoc_dict, out_txt, header, mtc_method="holm"):
    """
    Writes only significant vs-control comparisons based on adjusted p-values.
    """
    adj_col = f"P_{mtc_method}"

    def stars(p):
        if not np.isfinite(p): return ""
        if p < 0.001: return "***"
        if p < 0.01:  return "**"
        if p < 0.05:  return "*"
        return ""

    with open(out_txt, "w", encoding="utf-8") as f:
        f.write(header + "\n\n")
        found = False
        for name, df in posthoc_dict.items():
            if df is None or df.empty or adj_col not in df.columns:
                continue
            sig = df[df[adj_col] < 0.05].copy()
            if sig.empty:
                continue
            found = True
            f.write(f"--- {name} ---\n")
            for _, r in sig.iterrows():
                p = float(r[adj_col])
                f.write(f"{r['Comparison']}: p_adj={p:.4g} {stars(p)}\n")
            f.write("\n")
        if not found:
            f.write("No significant post-hoc vs-control comparisons at adjusted p < 0.05.\n")



_BAD_TAXA = {
    "", "unknown", "uncultured", "uncultured_bacterium", "uncultured_organism",
    "metagenome", "freshwater_metagenome", "unidentified", "unclassified"
}

def _clean_taxon(x: str) -> str:
    x = str(x).strip()
    if not x:
        return "Unclassified_Taxa"
    xl = x.lower()
    if xl in _BAD_TAXA:
        return "Unclassified_Taxa"
    if xl.startswith("uncultured"):
        return "Unclassified_Taxa"
    if xl in {"na", "nan"}:
        return "Unclassified_Taxa"
    return x

def parse_genus_from_taxonomy(t: str) -> str:
    parts = str(t).split(";")
    if len(parts) >= 6:
        return _clean_taxon(parts[5])
    return "Unclassified_Taxa"

def parse_species_from_taxonomy(t: str) -> str:
    parts = str(t).split(";")
    if len(parts) >= 7:
        return _clean_taxon(parts[6])
    return "Unclassified_Taxa"

def collapse_table_by_rank(df_counts: pd.DataFrame, rank: str) -> pd.DataFrame:
    if rank == "genere":
        labels = [parse_genus_from_taxonomy(c) for c in df_counts.columns]
    elif rank == "specie":
        labels = [parse_species_from_taxonomy(c) for c in df_counts.columns]
    else:
        raise ValueError("rank must be 'genere' or 'specie'")

    tmp = df_counts.copy()
    tmp.columns = labels
    tmp = tmp.groupby(level=0, axis=1).sum()
    tmp = tmp.loc[:, (tmp != 0).any(axis=0)]
    return tmp

def relative_abundance(df_counts: pd.DataFrame) -> pd.DataFrame:
    row_sums = df_counts.sum(axis=1).replace(0, np.nan)
    return df_counts.div(row_sums, axis=0).fillna(0.0)

def top_taxa_with_other(df_rel: pd.DataFrame, top_n=10) -> pd.DataFrame:
    ranking = df_rel.drop(columns=["Unclassified_Taxa"], errors="ignore").sum(axis=0)
    top = ranking.sort_values(ascending=False).head(top_n).index.tolist()
    keep = [t for t in top if t in df_rel.columns]

    other_cols = [c for c in df_rel.columns if c not in keep]
    df_out = df_rel[keep].copy()
    df_out["Other/Unclassified"] = df_rel[other_cols].sum(axis=1) if other_cols else 0.0
    return df_out

def taxa_palette(n):
    cols = list(sns.color_palette("colorblind", n_colors=min(10, n)))
    if len(cols) < n:
        extra = []
        extra += list(plt.get_cmap("tab20").colors)
        extra += list(plt.get_cmap("tab20b").colors)
        extra += list(plt.get_cmap("tab20c").colors)
        cyc = cycle(extra)
        while len(cols) < n:
            cols.append(next(cyc))
    return [to_hex(c) for c in cols[:n]]

GLOBAL_TAXA_COLORS = {}

def create_taxa_color_map(taxa_list):

    global GLOBAL_TAXA_COLORS

    existing_colors = list(GLOBAL_TAXA_COLORS.values())

    palette = taxa_palette(500)
    palette_iter = iter([c for c in palette if c not in existing_colors])

    for taxon in taxa_list:
        if taxon not in GLOBAL_TAXA_COLORS:
            GLOBAL_TAXA_COLORS[taxon] = next(palette_iter)

    cmap = {t: GLOBAL_TAXA_COLORS[t] for t in taxa_list}
    cmap["Other/Unclassified"] = "#333333"

    return cmap

def plot_stacked_individual_from_csv(df_rel_top: pd.DataFrame,
                                     sample_to_group: dict,
                                     ordered_treatments_norm: list,
                                     out_png: str,
                                     title: str):

    samples = df_rel_top.index.tolist()

    def sort_key(s):
        tr = sample_to_group.get(s, "unknown")
        try:
            tr_idx = ordered_treatments_norm.index(tr)
        except ValueError:
            tr_idx = len(ordered_treatments_norm)
        m = re.search(r"(\d+)", str(s))
        num = int(m.group(1)) if m else 999999
        return (tr_idx, num, str(s).lower())

    sample_order = sorted(samples, key=sort_key)
    df_plot = df_rel_top.loc[sample_order]

    taxa_list = df_plot.columns.tolist()
    taxa_cmap = create_taxa_color_map(taxa_list)
    colors = [taxa_cmap[t] for t in taxa_list]

    fig, ax = plt.subplots(figsize=(24, 12))
    df_plot.plot(kind="bar", stacked=True, width=1.0, ax=ax, color=colors)

    ax.set_xticklabels([str(s).split("/")[-1].split("_")[0] for s in sample_order], rotation=45, ha="right")
    ax.set_ylabel("Relative Abundance")
    ax.set_xlabel("")
    ax.legend(bbox_to_anchor=(1.05, 1), loc="upper left", title="Taxa")

    current = None
    starts = []
    labels = []
    for i, s in enumerate(sample_order):
        tr = sample_to_group.get(s, "unknown")
        if tr != current:
            if i > 0:
                ax.axvline(x=i - 0.5, color="black", linestyle="--", linewidth=1.5)
            current = tr
            starts.append(i)
            labels.append(tr)

    for start, lab in zip(starts, labels):
        end_idx = next((x for x in starts if x > start), len(sample_order)) - 1
        center = (start + end_idx) / 2
        ax.text(center, -0.28, lab, ha="center", va="top",
                transform=ax.get_xaxis_transform(),
                fontsize=14, fontweight="bold",
                bbox=dict(facecolor="lightgray", alpha=0.4, edgecolor="none",
                          boxstyle="round,pad=0.35"))

    plt.title(title)
    ax = plt.gca()
    ax.set_xlabel("")
    plt.tight_layout(rect=[0, 0.12, 1, 1])
    plt.savefig(out_png, bbox_inches="tight", dpi=300)
    plt.close()

def plot_stacked_mean_from_csv(df_rel_top: pd.DataFrame,
                               sample_to_group: dict,
                               ordered_treatments_norm: list,
                               out_png: str,
                               title: str,
                               taxa_cmap=None):

    df = df_rel_top.copy()
    df["treatment"] = df.index.map(lambda s: sample_to_group.get(s, "unknown"))
    df_mean = df.groupby("treatment").mean()

    tr_order = [t for t in ordered_treatments_norm if t in df_mean.index]
    rest = [t for t in df_mean.index if t not in tr_order]
    df_mean = df_mean.loc[tr_order + sorted(rest)]

    taxa_list = [c for c in df_mean.columns if c != "treatment"]
    if taxa_cmap is None:
        taxa_cmap = create_taxa_color_map(taxa_list)

    colors = [taxa_cmap[t] for t in taxa_list]

    fig, ax = plt.subplots(figsize=(12, 8))
    df_mean[taxa_list].plot(kind="bar", stacked=True, width=0.85, ax=ax, color=colors)
    ax.set_xticklabels(df_mean.index, rotation=45, ha="right")
    ax.set_ylabel("Mean Relative Abundance")
    ax.set_xlabel("Treatment")
    ax.legend(bbox_to_anchor=(1.05, 1), loc="upper left", title="Taxa")
    plt.title(title)
    ax = plt.gca()
    ax.set_xlabel("")
    plt.tight_layout()
    plt.savefig(out_png, bbox_inches="tight", dpi=300)
    plt.close()
    
def create_shared_taxa_color_map(first_taxa_list, second_taxa_list):
    shared_order = []

    for t in first_taxa_list:
        if t not in shared_order:
            shared_order.append(t)

    for t in second_taxa_list:
        if t not in shared_order:
            shared_order.append(t)

    return create_taxa_color_map(shared_order)


def load_matrix_csv(path: str) -> pd.DataFrame:
    df = pd.read_csv(path)
    first_col = df.columns[0]
    df = df.set_index(first_col)
    df = df.apply(pd.to_numeric, errors="coerce").fillna(0)
    df = df.loc[:, (df != 0).any(axis=0)]
    return df


def analyze_dataset(matrix_csv,
                    out_dir,
                    label,
                    ordered_treatments_norm,
                    base_colors_map,
                    control_group_norm="control",
                    permanova_perm_global=999,
                    permanova_perm_pairwise=499,
                    seed=123,
                    top_n=10,
                    mtc_method="holm"):

    os.makedirs(out_dir, exist_ok=True)

    tabella = load_matrix_csv(matrix_csv)
    if tabella.empty:
        print(f"[{label}] Empty matrix: {matrix_csv}")
        return

    sample_names = list(tabella.index)
    sample_to_group = {s: extract_treatment_from_sample(s, ordered_treatments_norm) for s in sample_names}
    groups = np.array([sample_to_group[s] for s in sample_names], dtype=object)

    uniq_groups = np.unique(groups)
    if len(uniq_groups) < 2:
        print(f"[{label}] <2 groups; skipping stats.")
        return

    pal = {g: base_colors_map.get(g, "#999999") for g in uniq_groups}
    pal["unknown"] = "#999999"

    # ---------------- Abundance (genus/species) ----------------
    print(f"\n[{label}] --- Abundance plots from CSV ---")

    for rank in ["genere", "specie"]:
        df_rank_counts = collapse_table_by_rank(tabella, rank=rank)
        df_rank_rel = relative_abundance(df_rank_counts)
        df_rank_top = top_taxa_with_other(df_rank_rel, top_n=top_n)

        out_ind = os.path.join(out_dir, f"{label}_stacked_barplot_individual_{rank}.png")
        out_mean = os.path.join(out_dir, f"{label}_stacked_barplot_mean_{rank}.png")

        plot_stacked_individual_from_csv(
            df_rank_top, sample_to_group, ordered_treatments_norm, out_ind,
            title=f"{label} - Relative Abundance Top {top_n} {rank} per Sample"
        )
        plot_stacked_mean_from_csv(
            df_rank_top, sample_to_group, ordered_treatments_norm, out_mean,
            title=f"{label} - Mean Relative Abundance Top {top_n} {rank} per Treatment"
        )

        print(f"[{label}]   wrote: {os.path.basename(out_ind)}")
        print(f"[{label}]   wrote: {os.path.basename(out_mean)}")

    # ---------------- Alpha diversity ----------------
    print(f"\n[{label}] --- Alpha diversity + Kruskal–Wallis (global) ---")

    alpha_df = pd.DataFrame(index=tabella.index)
    alpha_df["shannon"] = tabella.apply(lambda r: shannon(r.values.astype(float)), axis=1)
    alpha_df["simpson"] = tabella.apply(lambda r: simpson_concentration(r.values.astype(float)), axis=1)
    alpha_df["group"] = [sample_to_group[s] for s in alpha_df.index]

    # plot order for groups
    order_plot = [t for t in ordered_treatments_norm if t in alpha_df["group"].unique()]
    other = [g for g in alpha_df["group"].unique() if g not in order_plot]
    order_plot += sorted([g for g in other if g != "unknown"])
    if "unknown" in alpha_df["group"].unique():
        order_plot.append("unknown")

    alpha_results = []
    posthoc_vs_control = {}

    for metric in ["shannon", "simpson"]:
        group_arrays = [alpha_df.loc[alpha_df["group"] == g, metric].dropna().values for g in np.unique(groups)]
        valid = [x for x in group_arrays if len(x) >= 2]
        H, pval = (np.nan, np.nan)
        if len(valid) >= 2:
            try:
                H, pval = kruskal(*valid)
            except Exception:
                H, pval = np.nan, np.nan

        alpha_results.append({
            "Dataset": label,
            "Metric": metric,
            "Test": "Kruskal-Wallis (global)",
            "Statistic": H,
            "P_value": pval
        })
        print(f"[{label}] Alpha {metric}: Kruskal–Wallis H={H:.4f}, p={pval:.4g}")

        # plot
        plt.figure(figsize=(10, 7))
        sns.boxplot(x="group", y=metric, data=alpha_df, order=order_plot, palette=pal)
        sns.stripplot(x="group", y=metric, data=alpha_df, order=order_plot,
                      color="black", jitter=True, size=5, alpha=0.7)
        plt.title(f"{label} - {metric.title()} (Kruskal–Wallis p={pval:.3g})")
        plt.xticks(rotation=45, ha="right")
        ax = plt.gca()
        ax.set_xlabel("")
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, f"{label}_alpha_{metric}.png"), dpi=300)
        plt.close()

        # post-hoc only vs control (only if global significant)
        if np.isfinite(pval) and pval < 0.05:
            ph = pairwise_vs_control_wilcoxon(
                alpha_df, metric,
                control_group=control_group_norm,
                group_col="group",
                mtc_method=mtc_method,
                alpha=0.05
            )
            posthoc_vs_control[f"Alpha_{metric}_vs_control"] = ph

            ph_path = os.path.join(out_dir, f"{label}_posthoc_alpha_{metric}_vs_control_{mtc_method}.csv")
            ph.to_csv(ph_path, index=False)

            adj_col = f"P_{mtc_method}"
            print(f"[{label}]   Post-hoc vs control ({mtc_method}) for {metric}:")
            if not ph.empty:
                print(ph[["Comparison", "W", "P_raw", adj_col, "Significant_adj"]].to_string(index=False))
            else:
                print("  (no comparisons)")

    pd.DataFrame(alpha_results).to_csv(os.path.join(out_dir, f"{label}_alpha_global_stats.csv"), index=False)

    # ---------------- Beta diversity ----------------
    print(f"\n[{label}] --- Beta diversity + PERMANOVA (global) + PCoA ---")

    X = tabella.values.astype(float)
    row_sums = X.sum(axis=1, keepdims=True)
    X_rel = np.divide(X, row_sums, out=np.zeros_like(X), where=row_sums > 0)
    X_pa = (X > 0).astype(int)

    dist_bray = pdist(X_rel, metric="braycurtis")
    dist_jacc = pdist(X_pa, metric="jaccard")

    beta_results = []

    for metric_name, dist_vec in [("BrayCurtis", dist_bray), ("Jaccard", dist_jacc)]:
        F, pval, nperm = permanova_test(dist_vec, groups, permutations=permanova_perm_global, seed=seed)
        beta_results.append({
            "Dataset": label,
            "Metric": metric_name,
            "Test": f"PERMANOVA (global) ({nperm} perm, seed={seed})",
            "F_stat": F,
            "P_value": pval
        })
        print(f"[{label}] Beta {metric_name}: PERMANOVA F={F:.4f}, p={pval:.4g} (nperm={nperm})")

        # PCoA plot
        coords, eigvals = pcoa_manual(dist_vec, tabella.index)
        if "PC2" in coords.columns:
            coords["group"] = [sample_to_group[s] for s in coords.index]
            total = np.sum(eigvals[eigvals > 1e-9])
            pc1 = (eigvals[0] / total) if total > 0 else 0.0
            pc2 = (eigvals[1] / total) if total > 0 else 0.0

            marker_list = ['o', 's', 'D', '^', 'v', 'P', 'X', '*', '<', '>']
            order_groups = [g for g in ordered_treatments_norm if g in np.unique(groups)]
            other_groups = [g for g in np.unique(groups) if g not in order_groups]
            full_order = order_groups + sorted(other_groups)
            marker_map = {g: marker_list[i % len(marker_list)] for i, g in enumerate(full_order)}

            plt.figure(figsize=(10, 8))
            for g in full_order:
                sub = coords[coords["group"] == g]
                if sub.empty:
                    continue
                m = marker_map.get(g, "o")
                c = pal.get(g, "#999999")
                plt.scatter(sub["PC1"], sub["PC2"], s=130, label=g, c=[c],
                            marker=m, edgecolors="black", linewidths=0.5, alpha=0.95)

            plt.xlabel(f"PCo1 ({pc1:.1%})")
            plt.ylabel(f"PCo2 ({pc2:.1%})")
            plt.title(f"{label} - PCoA {metric_name} (PERMANOVA F={F:.3f}, p={pval:.3g})")

            handles = []
            for g in full_order:
                c = pal.get(g, "#999999")
                m = marker_map.get(g, "o")
                handles.append(mlines.Line2D([], [], color='w', marker=m,
                                             markerfacecolor=c, markeredgecolor='black',
                                             markersize=10, label=g))
            plt.legend(handles=handles, bbox_to_anchor=(1.05, 1), loc="upper left", title="Treatment")
            ax = plt.gca()
            ax.set_xlabel("")
            plt.tight_layout()
            plt.savefig(os.path.join(out_dir, f"{label}_pcoa_{metric_name}.png"), dpi=300)
            plt.close()

        # post-hoc only vs control (only if global significant)
        if np.isfinite(pval) and pval < 0.05:
            ph = pairwise_permanova_vs_control(
                dist_vec, groups,
                control_group=control_group_norm,
                permutations=permanova_perm_pairwise,
                seed=seed,
                mtc_method=mtc_method,
                alpha=0.05
            )
            posthoc_vs_control[f"Beta_{metric_name}_vs_control"] = ph

            ph_path = os.path.join(out_dir, f"{label}_posthoc_beta_{metric_name}_vs_control_{mtc_method}.csv")
            ph.to_csv(ph_path, index=False)

            adj_col = f"P_{mtc_method}"
            print(f"[{label}]   Post-hoc PERMANOVA vs control ({mtc_method}) for {metric_name}:")
            if not ph.empty:
                print(ph[["Comparison", "F", "P_raw", adj_col, "Significant_adj"]].to_string(index=False))
            else:
                print("  (no comparisons)")

    pd.DataFrame(beta_results).to_csv(os.path.join(out_dir, f"{label}_beta_global_stats.csv"), index=False)

    # ---------------- Significant summary report ----------------
    report_path = os.path.join(out_dir, f"{label}_stat_report_significant_vs_control_{mtc_method}.txt")
    header = (
        f"Significant post-hoc comparisons (treatment vs control) with adjusted p < 0.05\n"
        f"Dataset: {label}\n"
        f"Control group: {control_group_norm}\n\n"
        f"- Alpha: Shannon, Simpson concentration; global Kruskal–Wallis; post-hoc Mann–Whitney U tests (two-sided) versus control only when the global test was significant (p<0.05)\n"
        f"- Beta: BrayCurtis (rel. abundance), Jaccard (presence/absence); global PERMANOVA; post-hoc PERMANOVA vs control only if global p<0.05\n"
        f"- Multiple-testing correction: {mtc_method} applied ONLY within each vs-control family (per metric)\n"
    )
    write_significant_report_vs_control(posthoc_vs_control, report_path, header, mtc_method=mtc_method)

    print(f"\n[{label}]  Done. Outputs: {out_dir}")


def main():
    setup_publication_style()

    p = argparse.ArgumentParser(description="Alpha/Beta diversity + Abundance stacked bars from CSV (your taxonomy format)")
    p.add_argument("--adults_csv", required=True, help="Adults sample×taxa CSV")
    p.add_argument("--nymphs_csv", required=False, help="Nymphs sample×taxa CSV")
    p.add_argument("--out_dir", required=True, help="Output root directory")
    p.add_argument("--top_n", type=int, default=10)
    p.add_argument("--permanova_perm_global", type=int, default=999)
    p.add_argument("--permanova_perm_pairwise", type=int, default=499)
    p.add_argument("--seed", type=int, default=123)

    p.add_argument("--ordered_treatments",
                   default="Control,Ethanol,Bleach,DNA/RNA Zap,Lyzo_Zap,Lyzo_Bleach",
                   help="Comma-separated treatment order for plots")

    p.add_argument("--control_label", default="Control",
                   help="Control label as written in --ordered_treatments (e.g. 'Control' or 'Controllo').")

    p.add_argument("--mtc_method", default="fdr_bh", choices=["holm", "fdr_bh", "bonferroni", "sidak"],
                   help="Multiple testing correction for vs-control post-hoc families (default: holm).")

    args = p.parse_args()

    out_root = os.path.abspath(args.out_dir)
    os.makedirs(out_root, exist_ok=True)

    ordered_cli = [x.strip() for x in args.ordered_treatments.split(",") if x.strip()]
    ordered_treatments_norm = [normalize_label_cli(x) for x in ordered_cli]

    control_group_norm = normalize_label_cli(args.control_label)

    base_colors_map = dict(BASE_COLORS)
    for t in ordered_treatments_norm:
        if t not in base_colors_map:
            base_colors_map[t] = "#999999"

    analyze_dataset(
        matrix_csv=os.path.abspath(args.adults_csv),
        out_dir=os.path.join(out_root, "adults"),
        label="Adults",
        ordered_treatments_norm=ordered_treatments_norm,
        base_colors_map=base_colors_map,
        control_group_norm=control_group_norm,
        permanova_perm_global=args.permanova_perm_global,
        permanova_perm_pairwise=args.permanova_perm_pairwise,
        seed=args.seed,
        top_n=args.top_n,
        mtc_method=args.mtc_method
    )

    if args.nymphs_csv:
        analyze_dataset(
            matrix_csv=os.path.abspath(args.nymphs_csv),
            out_dir=os.path.join(out_root, "nymphs"),
            label="Nymphs",
            ordered_treatments_norm=ordered_treatments_norm,
            base_colors_map=base_colors_map,
            control_group_norm=control_group_norm,
            permanova_perm_global=args.permanova_perm_global,
            permanova_perm_pairwise=args.permanova_perm_pairwise,
            seed=args.seed,
            top_n=args.top_n,
            mtc_method=args.mtc_method
        )

if __name__ == "__main__":
    main()
