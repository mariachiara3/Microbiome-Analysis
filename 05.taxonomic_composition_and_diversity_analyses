def calculate_relative_abundance_matrix(df: pd.DataFrame, category: str) -> pd.DataFrame:
    df_grouped = df.groupby([category, "sample"])["count"].sum().reset_index()
    df_pivot = df_grouped.pivot_table(index=category, columns="sample", values="count", fill_value=0)
    return df_pivot.div(df_pivot.sum(axis=0), axis=1)


def prepare_top_taxa_data(df_pivot_rel: pd.DataFrame, top_n: int = 10) -> pd.DataFrame:
    df_temp = df_pivot_rel.drop(index="Unclassified_Taxa", errors="ignore")
    taxa_totals = df_temp.sum(axis=1)
    top_taxa = taxa_totals.sort_values(ascending=False).head(top_n).index
    taxa_to_sum = df_pivot_rel.index.difference(top_taxa)

    df_top = df_pivot_rel.loc[top_taxa].copy()
    df_other = df_pivot_rel.loc[taxa_to_sum].sum(axis=0)
    df_top.loc["Other/Unclassified"] = df_other
    return df_top


def get_all_top_taxa(df_list: List[pd.DataFrame], category: str, top_n: int) -> List[str]:
    all_top_taxa: set[str] = set()
    for df in df_list:
        if df.empty:
            continue
        df_pivot_rel = calculate_relative_abundance_matrix(df, category)
        df_temp = df_pivot_rel.drop(index="Unclassified_Taxa", errors="ignore")
        taxa_totals = df_temp.sum(axis=1)
        top_taxa = taxa_totals.sort_values(ascending=False).head(top_n).index
        all_top_taxa.update(top_taxa)
    return list(all_top_taxa)


def create_global_color_map(
    df_list: List[pd.DataFrame],
    category: str,
    top_n: int,
    palette,
    fixed_map: Dict[str, str],
    borrelia_color: str | None = None,
) -> Dict[str, str]:
    global_taxa = get_all_top_taxa(df_list, category, top_n)
    global_color_map: Dict[str, str] = {}
    taxa_to_remove: List[str] = []

    for substr, color_hex in fixed_map.items():
        for full_name in global_taxa:
            if substr.lower() in full_name.lower() and full_name not in global_color_map:
                global_color_map[full_name] = color_hex
                taxa_to_remove.append(full_name)

    if borrelia_color:
        for full_name in global_taxa:
            if ("Borrelia" in full_name or "Borreliella" in full_name) and full_name not in global_color_map:
                global_color_map[full_name] = borrelia_color
                taxa_to_remove.append(full_name)

    remaining_taxa = [t for t in global_taxa if t not in set(taxa_to_remove)]

    fixed_colors_used = set(fixed_map.values())
    if borrelia_color:
        fixed_colors_used.add(borrelia_color)

    available_palette = [c for c in palette if c not in fixed_colors_used]
    palette_cycle = cycle(available_palette)

    for taxon in remaining_taxa:
        global_color_map[taxon] = next(palette_cycle)

    global_color_map["Other/Unclassified"] = OTHER_COLOR
    return global_color_map


def create_individual_plots(
    df_all: pd.DataFrame,
    category: str,
    output_dir: str,
    global_color_map: Dict[str, str],
    sample_to_group: Dict[str, str],
    ordered_treatments: List[str],
    top_n: int = 10,
) -> None:
    df_pivot_rel = calculate_relative_abundance_matrix(df_all, category)
    df_top = prepare_top_taxa_data(df_pivot_rel, top_n=top_n)

    all_samples = list(df_pivot_rel.columns)

    def sort_key(sample_name: str) -> Tuple[int, int]:
        treatment = sample_to_group.get(sample_name, "Unknown")
        try:
            treatment_index = ordered_treatments.index(treatment)
        except ValueError:
            treatment_index = len(ordered_treatments)

        try:
            sample_part = sample_name.split("_")[-1]
            num_str = "".join(filter(str.isdigit, sample_part))
            num = int(num_str) if num_str else 999
        except Exception:
            num = 999

        return (treatment_index, num)

    sample_order = sorted(all_samples, key=sort_key)
    df_plot = df_top.T.loc[sample_order]

    taxa_order = list(df_plot.columns)
    if "Other/Unclassified" in taxa_order:
        taxa_order.remove("Other/Unclassified")
        taxa_order.append("Other/Unclassified")
    df_plot = df_plot[taxa_order]

    fig, ax = plt.subplots(figsize=(24, 12))
    colors = [global_color_map.get(t, "#c7c7c7") for t in df_plot.columns]
    df_plot.plot(kind="bar", stacked=True, width=1.0, ax=ax, color=colors)

    ax.set_xticklabels([s.split("_")[-1] for s in sample_order], rotation=45, ha="right")
    ax.set_ylabel("Relative abundance", fontsize=14)
    ax.set_xlabel("")

    label_category = "genera" if category.lower() == "genere" else "species"
    ax.legend(bbox_to_anchor=(1.05, 1), loc="upper left", fontsize="small", title=label_category)
    ax.set_title(f"Relative abundance of top {top_n} {label_category} per sample", fontsize=16)

    current_group = None
    group_labels: List[str] = []
    group_positions: List[float] = []

    for i, sample in enumerate(sample_order):
        treatment = sample_to_group.get(sample, "Unknown")
        if treatment != current_group:
            if i > 0:
                ax.axvline(x=i - 0.5, color="black", linestyle="--", linewidth=2)
            group_labels.append(treatment)
            group_positions.append(i - 0.5)
            current_group = treatment

    group_positions.append(len(sample_order) - 0.5)
    for j, label in enumerate(group_labels):
        start = group_positions[j]
        end = group_positions[j + 1]
        center = (start + end) / 2
        ax.text(
            center,
            -0.25,
            label,
            ha="center",
            va="top",
            transform=ax.get_xaxis_transform(),
            fontsize=12,
            fontweight="bold",
            bbox=dict(facecolor="lightgray", alpha=0.5, edgecolor="none", boxstyle="round,pad=0.5"),
        )

    plt.tight_layout(rect=[0, 0.1, 1, 1])
    out = os.path.join(output_dir, f"stacked_barplot_individual_{category}.png")
    plt.savefig(out, bbox_inches="tight", dpi=300)
    plt.close()


def create_mean_plots(
    df_all: pd.DataFrame,
    category: str,
    output_dir: str,
    global_color_map: Dict[str, str],
    sample_to_group: Dict[str, str],
    ordered_treatments: List[str],
    top_n: int = 10,
) -> None:
    df_pivot_rel = calculate_relative_abundance_matrix(df_all, category)
    df_pivot_rel_t = df_pivot_rel.T
    df_pivot_rel_t["treatment"] = df_pivot_rel_t.index.map(sample_to_group)

    df_mean = df_pivot_rel_t.groupby("treatment").mean()
    df_taxa_pivot = df_mean.T
    df_top_mean = prepare_top_taxa_data(df_taxa_pivot, top_n=top_n)

    top_taxa = df_top_mean.index.drop("Other/Unclassified").tolist()
    df_plot = df_mean[top_taxa].copy()
    df_plot["Other/Unclassified"] = df_top_mean.loc["Other/Unclassified"]
    df_plot = df_plot.fillna(0)

    treatment_order = [t for t in ordered_treatments if t in df_plot.index]
    df_plot = df_plot.loc[treatment_order]

    taxa_order = list(df_plot.columns)
    if "Other/Unclassified" in taxa_order:
        taxa_order.remove("Other/Unclassified")
        taxa_order.append("Other/Unclassified")
    df_plot = df_plot[taxa_order]

    fig, ax = plt.subplots(figsize=(12, 8))
    colors = [global_color_map.get(t, "#c7c7c7") for t in df_plot.columns]
    df_plot.plot(kind="bar", stacked=True, width=0.8, ax=ax, color=colors)

    ax.set_xticklabels(df_plot.index, rotation=45, ha="right")
    ax.set_ylabel("Mean relative abundance", fontsize=14)
    ax.set_xlabel("Treatment group", fontsize=14)

    label_category = "genera" if category.lower() == "genere" else "species"
    ax.legend(bbox_to_anchor=(1.05, 1), loc="upper left", fontsize="small", title=label_category)
    ax.set_title(f"Mean relative abundance of top {top_n} {label_category} per treatment", fontsize=16)

    plt.tight_layout()
    out = os.path.join(output_dir, f"stacked_barplot_mean_{category}.png")
    plt.savefig(out, bbox_inches="tight", dpi=300)
    plt.close()


def process_abundance_analysis_initial(
    folder_list: List[str],
    group_label: str,
    folder_name_mapping: Dict[str, str],
) -> Tuple[pd.DataFrame, Dict[str, str]]:
    print(f"\n--- Loading abundance tables: {group_label} ---")
    all_data: List[pd.DataFrame] = []

    for folder in folder_list:
        if not os.path.isdir(folder):
            continue

        folder_name_full = os.path.basename(folder.rstrip("/"))
        treatment = folder_name_mapping.get(folder_name_full, folder_name_full)

        for filename in os.listdir(folder):
            if not filename.endswith("_subsampled_taxa.txt"):
                continue

            filepath = os.path.join(folder, filename)
            sample_base = os.path.splitext(filename)[0].replace("_subsampled_taxa", "")
            sample_name_unique = f"{treatment}_{sample_base}"

            try:
                df = pd.read_csv(filepath, sep="\t", header=None, names=["taxonomy", "count", "read_ids"])
                df["count"] = pd.to_numeric(df["count"], errors="coerce").fillna(0)

                taxonomy_parts = df["taxonomy"].astype(str).str.split(";")

                df["genere"] = taxonomy_parts.apply(
                    lambda x: x[5].strip() if len(x) >= 6 and x[5].strip() not in ("g__", "") else "Unclassified_Taxa"
                )

                def get_species(parts: List[str]) -> str:
                    if len(parts) >= 7 and parts[6].strip() not in ("s__", "s__uncultured", "s__metagenome", ""):
                        return parts[6].strip()
                    return "Unclassified_Taxa"

                df["specie"] = taxonomy_parts.apply(get_species)

                df["sample"] = sample_name_unique
                df["treatment"] = treatment
                all_data.append(df)

            except Exception as e:
                print(f"[WARN] Failed to parse {filepath}: {e}")

    if not all_data:
        print(f"[WARN] No valid abundance data found for {group_label}.")
        return pd.DataFrame(), {}

    df_all = pd.concat(all_data, ignore_index=True)
    sample_to_group = (
        df_all[["sample", "treatment"]].drop_duplicates().set_index("sample")["treatment"].to_dict()
    )

    print(f"Loaded {len(sample_to_group)} samples for {group_label}.")
    return df_all, sample_to_group


def process_plotting(
    df_all: pd.DataFrame,
    group_label: str,
    output_dir: str,
    global_color_map_genere: Dict[str, str],
    global_color_map_specie: Dict[str, str],
    sample_to_group: Dict[str, str],
    ordered_treatments: List[str],
    top_n: int,
) -> None:
    if df_all.empty:
        return

    print(f"\n--- Generating abundance plots: {group_label} ---")
    create_individual_plots(df_all, "genere", output_dir, global_color_map_genere, sample_to_group, ordered_treatments, top_n=top_n)
    create_individual_plots(df_all, "specie", output_dir, global_color_map_specie, sample_to_group, ordered_treatments, top_n=top_n)
    create_mean_plots(df_all, "genere", output_dir, global_color_map_genere, sample_to_group, ordered_treatments, top_n=top_n)
    create_mean_plots(df_all, "specie", output_dir, global_color_map_specie, sample_to_group, ordered_treatments, top_n=top_n)


